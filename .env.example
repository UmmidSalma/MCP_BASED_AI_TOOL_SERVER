# Local service and filesystem policy
FLASK_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
TOKEN_DB_PATH=var/tokens.sqlite3
OUTPUT_DIR=outputs
RATE_LIMIT_CALLS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional local model artifacts (no model is bundled)
FRAUD_MODEL_PATH=models/fraud_xgb.json
FRAUD_MEDIUM_THRESHOLD=0.3
FRAUD_HIGH_THRESHOLD=0.7
IMAGE_ROOT=images
ANTHROPIC_API_KEY=
CLAUDE_IMAGE_CHAT_MODEL=claude-sonnet-4-5

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Notion OAuth integration credentials
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:8000/auth/notion/callback